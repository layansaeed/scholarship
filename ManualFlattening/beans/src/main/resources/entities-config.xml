                   column="scholarship_university_recommendation_status_identification"/>
            <field name="academicDegreeIdentification"
                   column="academic_degree_identification"/>
            <field name="academicStudyFieldIdentification"
                   column="academic_study_field_identification"/>
            <field name="academicCourseMajorIdentification"
                   column="academic_course_major_identification"/>
            <field name="scholarshipInstituteCountryIdentification"
                   column="scholarship_institute_country_identification"/>
            <field name="studentGraduationDate"
                   column="student_graduation_date"/>
            <field name="academicInstitute"
                   column="academic_institute"/>
            <field name="scholarshipEndDate"
                   column="scholarship_end_date"/>
            <field name="scholarshipStartDate"
                   column="scholarship_start_date"/>
            <field name="studentCompanionRelationship"
                   column="student_companion_relationship"/>
            <field name="scholarshipSponsorIdentification"
                   column="scholarship_sponsor_identification"/>
            <field name="certificateAccreditationStatusIdentification"
                   column="certificate_accreditation_status_identification"/>
            <field name="scholarshipDecisionDate"
                   column="scholarship_decision_date"/>
            <field name="scholarshipStatusIdentification"
                   column="scholarship_status_identification"/>
            <field name="scholarshipStipendEndDate"
                   column="scholarship_stipend_end_date"/>
            <field name="scholarshipStipendStartDate"
                   column="scholarship_stipend_start_date"/>
            <field name="studentInsuranceStatusFlag"
                   column="student_insurance_status_flag"/>
            <field name="scholarshipDecisionStartDate"
                   column="scholarship_decision_start_date"/>
            <field name="scholarshipDecisionNumber"
                   column="scholarship_decision_number"/>
            <field name="studentIdentificationNumber"
                   column="student_identification_number"/>
        </fields>

    </entity>

    <entity name="ScholarshipStageInformation"
            table="SCHOLARSHIP_STAGE_INFO_INT"
            schema="nrd">

        <fields>
            <field name="studentIdentificationNumber" column="student_identification_number" />
            <field name="scholarshipRowId" column="scholarship_row_id" />

            <field name="studentAcademicNumber"
                   column="student_academic_number"/>
            <field name="academicStageIdentification"
                   column="academic_stage_identification"/>
            <field name="scholarshipStudyTypeIdentification"
                   column="scholarship_study_type_identification"/>
            <field name="studentAcademicGPA"
                   column="student_academic_gpa"/>
            <field name="programStageTypeIdentification"
                   column="program_stage_type_identification"/>
            <field name="studyPeriod"
                   column="study_period"/>
            <field name="thesisTitle"
                   column="thesis_title"/>
        </fields>

    </entity>

</entities>



