<?xml version="1.0" encoding="UTF-8"?>
<!--  When we add a new table, we just add a new <entity> section to this file - no Java coding required!-->
<!--  <entity> Represents one database table has Attributes inside tage<> -->
<!--  <field> Represents one column in the table has Attributes inside tage<> -->
<!--  <data> Represents Sample data or initial values, Contains <value> elements with actual data & has Attributes-->

    <entities>

    <entity name="HRSD_DIS_ASS"
            table="HRSD_Disability_Assessment_Service"
            schema="nrd">

            <fields>

                <field name="nationalId" column="national_id" />

                <field name="firstName" column="first_name" />

                <field name="dob" column="dob"/>

                <field name="cityCode" column="city_code" />

                <field name="mobileNumber" column="mobile" />

                <field name="disabilityId" column="disability_id" />

                <field name="disabilityType" column="disability_type" />

                <field name="category" column="category"/>

                <field name="iq" column="iq"/>

                <field name="disabilityDate" column="disability_date"/>

                <field name="expiredDate" column="expired_date"/>

                <field name="disabilityDescriptionBeneficiary" column="dis_desc_benf"/>

                <field name="failure" column="failure"/>

                <field name="message" column="MESSAGE"/>
            </fields>


    </entity>

    <!-- Beneficiary Entity -->
    <entity name="HRDF_BENF_INQ"
           table="BENEF_NINS" schema="ETL">

    <!--            table="SERVICES_ANALYTICS_TABLE_INT"-->

        <fields>
            <field name="nin"
                   column="nin"/>

<!--            <field name="birthDate"-->
<!--                   column="DOB"/>-->

        </fields>

    </entity>

    <entity name="SCHOLARSHIP"
